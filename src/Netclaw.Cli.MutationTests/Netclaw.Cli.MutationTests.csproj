    <Compile Include="../Netclaw.Cli.Tests/Cli/ChatClientCloseExpiryScenario.cs" Link="Cli/ChatClientCloseExpiryScenario.cs" />
    <Compile Include="../Netclaw.Cli.Tests/Skills/SkillRemoveBoundaryTests.cs" Link="Skills/SkillRemoveBoundaryTests.cs" />
