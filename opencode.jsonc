{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-5.5",
  "agent": {
    "build": {
      "model": "openai/gpt-5.5",
      "variant": "xhigh"
    },
    "plan": {
      "model": "openai/gpt-5.5",
      "variant": "xhigh"
    },
    "general": {
      "model": "openai/gpt-5.5",
      "variant": "xhigh"
    }
  },
  "mcp": {
    "aspire": {
      "type": "local",
      "command": [
        "aspire",
        "mcp",
        "start"
      ],
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@latest"
      ],
      "enabled": true
    }
  }
}
