{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.netclaw.local/webhook-route/v1",
  "title": "Netclaw Webhook Route v1",
  "type": "object",
  "properties": {
    "enabled": {
      "type": "boolean",
      "default": true
    },
    "verification": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["Hmac", "HeaderSecret", "HmacTimestamped"],
          "default": "Hmac"
        },
        "hmacAlgorithm": {
          "type": "string",
          "enum": ["Sha256"],
          "default": "Sha256"
        },
        "secret": {
          "type": ["string", "null"]
        },
        "signatureHeaderName": {
          "type": ["string", "null"]
        },
        "signaturePrefix": {
          "type": ["string", "null"]
        },
        "secretHeaderName": {
          "type": ["string", "null"]
        },
        "eventHeaderName": {
          "type": ["string", "null"]
        },
        "deliveryIdHeaderName": {
          "type": ["string", "null"]
        },
        "toleranceSeconds": {
          "type": ["integer", "null"],
          "default": 300
        },
        "timestampField": {
          "type": ["string", "null"],
          "default": "t"
        },
        "signatureField": {
          "type": ["string", "null"],
          "default": "v1"
        },
        "signedPayloadSeparator": {
          "type": ["string", "null"],
          "default": "."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": { "const": "HmacTimestamped" }
            },
            "required": ["kind"]
          },
          "then": {
            "properties": {
              "toleranceSeconds": {
                "type": ["integer", "null"],
                "minimum": 1,
                "maximum": 3600
              },
              "timestampField": {
                "type": ["string", "null"],
                "minLength": 1,
                "pattern": "^[!#$%&'*+.^_`|~0-9A-Za-z-]+$"
              },
              "signatureField": {
                "type": ["string", "null"],
                "minLength": 1,
                "pattern": "^[!#$%&'*+.^_`|~0-9A-Za-z-]+$"
              }
            }
          }
        }
      ],
      "additionalProperties": false,
      "required": ["kind"]
    },
    "events": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "audience": {
      "type": "string",
      "enum": ["Public", "Team", "Personal"],
      "default": "Public"
    },
    "prompt": {
      "type": "string",
      "default": ""
    },
    "notifyInstructions": {
      "type": "string",
      "default": ""
    },
    "deliveryRequired": {
      "type": "boolean",
      "default": true
    },
    "notificationTarget": {
      "type": ["object", "null"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["Slack"],
          "default": "Slack"
        },
        "channelId": {
          "type": ["string", "null"]
        }
      },
      "additionalProperties": false,
      "default": null
    },
    "maxBodyBytes": {
      "type": "integer",
      "minimum": 1,
      "default": 1048576
    },
    "rateLimitPerMinute": {
      "type": "integer",
      "minimum": 1,
      "default": 30
    }
  },
  "required": ["prompt", "verification"],
  "additionalProperties": false
}
