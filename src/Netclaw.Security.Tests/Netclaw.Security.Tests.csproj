<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Netclaw.Media/Netclaw.Media.csproj" />
    <ProjectReference Include="../Netclaw.Security/Netclaw.Security.csproj" />
    <ProjectReference Include="../Netclaw.Tools.Abstractions/Netclaw.Tools.Abstractions.csproj" />
  </ItemGroup>

  <!-- Evidence/ is the stable home of the approval and tool-friction evidence.
       Netclaw.Actors.Tests links files from this folder too. See Evidence/README.md. -->
  <ItemGroup>
    <None Remove="Evidence/**" />
    <None Include="Evidence/README.md" />
    <None Include="Evidence/ApprovalEvidence/*.json"
          Link="ApprovalEvidence/%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="Evidence/ToolFrictionEvidence/tool-friction-fixtures.json"
          Link="ToolFrictionEvidence/tool-friction-fixtures.json"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
