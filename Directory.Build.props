<Project>
  <PropertyGroup>
    <Copyright>Copyright © 2026-$([System.DateTime]::Now.Year) Stannard Labs</Copyright>
    <Authors>Stannard Labs</Authors>
    <Company>Stannard Labs</Company>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <VersionPrefix>0.1.0</VersionPrefix>
    <PackageReleaseNotes>Netclaw v0.1.0 — Initial Release. Actor-based session engine on Slack Socket Mode with SQLite persistence, extractive context compaction, MCP tool integration with OAuth 2.1, multi-provider LLM support (OpenRouter/Ollama), file-based memory, binary distribution feed with auto-update, secrets protection with encryption at rest, and a full init wizard and doctor CLI.</PackageReleaseNotes>
  </PropertyGroup>
  <PropertyGroup>
    <NetCoreTestVersion>net10.0</NetCoreTestVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
  </ItemGroup>
  <PropertyGroup>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)LICENSE" Pack="true" PackagePath="" Visible="false" />
  </ItemGroup>
</Project>
