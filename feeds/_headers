# CORS — allow daemon to fetch from any origin (localhost, tailscale hostnames)
/*
  Access-Control-Allow-Origin: *

# JSON manifests — short TTL so skill updates propagate quickly
/skills/.system/manifest.json
  Cache-Control: public, max-age=300
  Content-Type: application/json

# Skill files — immutable (versioned URLs never change content)
/skills/.system/files/*
  Cache-Control: public, max-age=31536000, immutable

# Binary releases manifest — short TTL so updates propagate quickly
/releases/manifest.json
  Cache-Control: public, max-age=300
  Content-Type: application/json

# Binary manifest signature and public key
/releases/manifest.json.sig
  Cache-Control: public, max-age=300
  Content-Type: text/plain

/releases/manifest.pub
  Cache-Control: public, max-age=300
  Content-Type: text/plain

# Install scripts — short TTL to pick up script improvements
/install.sh
  Cache-Control: public, max-age=300
  Content-Type: text/plain

/install.ps1
  Cache-Control: public, max-age=300
  Content-Type: text/plain
