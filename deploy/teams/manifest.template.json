{
  "$schema": "https://developer.microsoft.com/json-schemas/teams/v1.28/MicrosoftTeams.schema.json",
  "manifestVersion": "1.28",
  "version": "1.0.0",
  "id": "${{TEAMS_APP_ID}}",
  "developer": {
    "name": "${{DEVELOPER_NAME}}",
    "websiteUrl": "https://netclaw.dev",
    "privacyUrl": "${{PRIVACY_URL}}",
    "termsOfUseUrl": "${{TERMS_OF_USE_URL}}"
  },
  "name": {
    "short": "Netclaw",
    "full": "Netclaw self-hosted operations agent"
  },
  "description": {
    "short": "Run your own secure operations agent in Microsoft Teams.",
    "full": "Netclaw is a self-hosted operations agent. It receives standard team channel messages only to continue approved users' established bot threads and discards all other unmentioned messages before model processing."
  },
  "icons": {
    "outline": "outline.png",
    "color": "color.png"
  },
  "accentColor": "#6D4AFF",
  "supportsChannelFeatures": "tier1",
  "webApplicationInfo": {
    "id": "${{TEAMS_APP_ID}}",
    "resource": "https://netclaw"
  },
  "authorization": {
    "permissions": {
      "resourceSpecific": [
        {
          "type": "Application",
          "name": "ChannelMessage.Read.Group"
        },
        {
          "type": "Application",
          "name": "ChatMessage.Read.Chat"
        }
      ]
    }
  },
  "bots": [
    {
      "botId": "${{TEAMS_APP_ID}}",
      "scopes": [
        "personal",
        "team",
        "groupchat"
      ],
      "isNotificationOnly": false,
      "needsChannelSelector": false,
      "supportsCalling": false,
      "supportsFiles": true,
      "supportsVideo": false
    }
  ]
}
