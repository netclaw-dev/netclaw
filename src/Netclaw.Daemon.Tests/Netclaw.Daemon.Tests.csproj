<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Akka.Hosting.TestKit" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NSec.Cryptography" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" />
    <PackageReference Include="ModelContextProtocol.Core" />
    <PackageReference Include="Verify.XunitV3" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Netclaw.Actors/Netclaw.Actors.csproj" />
    <ProjectReference Include="../Netclaw.Channels/Netclaw.Channels.csproj" />
    <ProjectReference Include="../Netclaw.Channels.Discord/Netclaw.Channels.Discord.csproj" />
    <ProjectReference Include="../Netclaw.Channels.Mattermost/Netclaw.Channels.Mattermost.csproj" />
    <ProjectReference Include="../Netclaw.Channels.Slack/Netclaw.Channels.Slack.csproj" />
    <ProjectReference Include="../Netclaw.Configuration/Netclaw.Configuration.csproj" />
    <ProjectReference Include="../Netclaw.Daemon/Netclaw.Daemon.csproj" />
    <ProjectReference Include="../Netclaw.Providers/Netclaw.Providers.csproj" />
    <ProjectReference Include="../Netclaw.Tools.Abstractions/Netclaw.Tools.Abstractions.csproj" />
    <ProjectReference Include="../Netclaw.Tests.Utilities/Netclaw.Tests.Utilities.csproj" />
    <!-- Built (not linked) so SmokeMcpServerArgumentCoercionTests can launch
         the deterministic stdio MCP server as a child process. -->
    <ProjectReference Include="../../tests/Netclaw.SmokeMcpServer/Netclaw.SmokeMcpServer.csproj"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shared tiny fixture ONNX model (no network downloads in tests) — same physical files
         Netclaw.Embeddings.Tests uses, linked here for EmbeddingWarmupHostedServiceTests. -->
    <None Include="../Netclaw.Embeddings.Tests/Fixtures/*.onnx" Link="Fixtures/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../Netclaw.Embeddings.Tests/Fixtures/*.txt" Link="Fixtures/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
